{
  "name": "edgseu-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate-content.ts",
    "lint": "eslint .",
    "check": "pnpm validate && pnpm lint && astro check",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "test:validation": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "pnpm build && pnpm test:validation && playwright test",
    "quality": "pnpm test && tsx scripts/check-artifact.ts",
    "lighthouse": "tsx scripts/run-lighthouse.ts",
    "check:external": "tsx scripts/check-external-links.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/adwaita-sans": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "github-slugger": "2.0.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "cheerio": "1.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "gray-matter": "^4.0.3",
    "lighthouse": "13.5.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "serve-handler": "6.1.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5"
  }
}
