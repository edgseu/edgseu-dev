---
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string | undefined;
  modifiedTime?: string | undefined;
  tags?: readonly string[] | undefined;
}

const {
  title,
  description,
  image = '/images/social-card.svg',
  type = 'website',
  noindex = false,
  canonicalPath = Astro.url.pathname,
  jsonLd,
  publishedTime,
  modifiedTime,
  tags,
} = Astro.props;
const canonical = new URL(canonicalPath, site.canonicalUrl).href;
const imageUrl = new URL(image, site.canonicalUrl).href;
const fullTitle = title === profile.username ? title : `${title} · ${profile.username}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1F1F1F" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {tags && tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.username} Technical Writing RSS Feed`} href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.username} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {type === 'article' && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content={profile.name} />
        {tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('edgseu-theme');
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getUTCFullYear()} {profile.username}. Built as a static, accessible Site.</p>
      <nav aria-label="Footer">
        <a href={profile.github}><Icon name="github" size={14} /> GitHub</a>
        <a href={profile.linkedin}><Icon name="linkedin" size={14} /> LinkedIn</a>
        <a href={`mailto:${profile.email}`}><Icon name="envelope" size={14} /> Email</a>
      </nav>
    </footer>
  </body>
</html>
