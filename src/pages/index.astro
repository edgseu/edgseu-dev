---
import ArticleCard from '../components/ArticleCard.astro';
import ProfileRail from '../components/ProfileRail.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import { loadProjectCatalog } from '../lib/projects';
import { site } from '../data/site';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedArticles } from '../lib/articles';
import { Content as ProfileBio } from '../content/profile.md';
const { homepageProjects, isHomepageProjectGrid2x2 } = await loadProjectCatalog();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site.canonicalUrl,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.role,
    image: new URL(profile.avatar, site.canonicalUrl).href,
    sameAs: [profile.github, profile.linkedin],
    address: { '@type': 'PostalAddress', addressCountry: profile.location },
  },
};

---

<BaseLayout
  title={profile.username}
  description={`${profile.name}'s ${profile.role} profile, selected projects, and technical writing.`}
  jsonLd={jsonLd}
>
  <div class="home-grid">
    <ProfileRail />
    <div class="home-main">
      <Terminal />
      <section class="profile-prose" aria-label="Profile introduction">
        <ProfileBio />
      </section>

      <section class="project-section" aria-labelledby="selected-projects">
        <div class="section-heading">
          <div><h2 id="selected-projects">Selected projects</h2></div>
          <a href="/projects/">View all projects</a>
        </div>
        <div class={`cards ${isHomepageProjectGrid2x2 ? 'cards-grid-2x2' : ''}`}>{homepageProjects.map((project) => <ProjectCard project={project} />)}</div>
      </section>

      <section class="article-section" aria-labelledby="latest-articles">
        <div class="section-heading">
          <div><h2 id="latest-articles">Latest articles</h2></div>
          <a href="/articles/">View all articles</a>
        </div>
        {publishedArticles.length > 0 ? (
          <div class="cards">{publishedArticles.slice(0, 2).map((article) => <ArticleCard article={article} />)}</div>
        ) : (
          <p class="empty-state">No articles are published yet. Approved writing will appear here.</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
