---
import ProjectCard from '../components/ProjectCard.astro';
import { publishedProjects } from '../lib/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects"
  description="Selected Cloud and DevSecOps projects by Aman Bhushan Singh, linked directly to their public repositories."
>
  <header class="page-header">
    <p class="eyebrow">Proof of work</p>
    <h1>Projects</h1>
    <p>Curated public repositories covering cloud infrastructure, GitOps, security automation, and observability.</p>
  </header>
  <section aria-label="Published projects">
    <div class="cards">{publishedProjects.map((project) => <ProjectCard project={project} headingLevel={2} />)}</div>
  </section>
</BaseLayout>
