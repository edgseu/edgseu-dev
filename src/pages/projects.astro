---
import ProjectCard from '../components/ProjectCard.astro';
import { publishedProjects } from '../lib/projects';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects"
  description={`Selected Cloud and DevSecOps projects by ${profile.name}, linked directly to their public repositories.`}
>
  <header class="page-header project-page-header">
    <p class="eyebrow">Proof of work</p>
    <h1>Projects</h1>
    <p>Curated public repositories covering cloud infrastructure, GitOps, security automation, and observability.</p>
  </header>
  <section aria-label="Published projects">
    <div class="project-index-grid">{publishedProjects.map((project) => <ProjectCard project={project} headingLevel={2} />)}</div>
  </section>
</BaseLayout>
