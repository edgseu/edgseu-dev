---
import ArticleOutline from '../../components/ArticleOutline.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { profile } from '../../data/profile';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleNeighbors, visibleArticles } from '../../lib/articles';
import type { Article } from '../../lib/articles';

export function getStaticPaths() {
  return visibleArticles(import.meta.env.DEV).map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { frontmatter, Content, headings } = article;
const { newer, older } = articleNeighbors(article);
const isDraft = frontmatter.state === 'Draft';
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const commentsConfigured = Boolean(giscusRepoId && giscusCategoryId);
const githubOwner = profile.github.replace(/^https?:\/\/github\.com\//, '').replace(/\/$/, '');
const giscusRepo = `${githubOwner}/edgseu-dev`;
const discussionsUrl = `https://github.com/${githubOwner}/edgseu-dev/discussions/categories/article-comments`;
const canonicalArticleUrl = new URL(article.path, site.canonicalUrl).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: frontmatter.title,
    description: frontmatter.summary,
    inLanguage: 'en-US',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalArticleUrl,
    },
    url: canonicalArticleUrl,
    image: new URL('/images/social-card.svg', site.canonicalUrl).href,
    datePublished: frontmatter.publishedAt,
    dateModified: frontmatter.revisedAt ?? frontmatter.publishedAt,
    author: {
      '@type': 'Person',
      name: profile.name,
      url: site.canonicalUrl,
      sameAs: [profile.github, profile.linkedin],
      jobTitle: profile.role,
    },
    publisher: {
      '@type': 'Person',
      name: profile.name,
      url: site.canonicalUrl,
    },
    ...(frontmatter.tags && frontmatter.tags.length > 0 ? { keywords: frontmatter.tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Overview',
        item: site.canonicalUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Articles',
        item: new URL('/articles/', site.canonicalUrl).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: frontmatter.title,
        item: canonicalArticleUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.summary}
  type="article"
  canonicalPath={article.path}
  noindex={isDraft}
  jsonLd={jsonLd}
  publishedTime={frontmatter.publishedAt}
  modifiedTime={frontmatter.revisedAt ?? frontmatter.publishedAt}
  tags={frontmatter.tags}
>
  <div class="article-context">
    <a href="/articles/">Articles</a><span aria-hidden="true">/</span><span>{frontmatter.title}</span>
  </div>
  <article>
    <header class="article-header">
      {isDraft && <p class="draft-banner">Draft preview — this Article is not included in production.</p>}
      <h1>{frontmatter.title}</h1>
      <p class="summary">{frontmatter.summary}</p>
      <div class="metadata">
        <span>By {profile.username}</span>
        {frontmatter.publishedAt && (
          <time datetime={frontmatter.publishedAt}>
            <Icon name="calendar" size={14} />
            <span>Published {frontmatter.publishedAt}</span>
          </time>
        )}
        {frontmatter.revisedAt && (
          <time datetime={frontmatter.revisedAt}>
            <Icon name="calendar" size={14} />
            <span>Revised {frontmatter.revisedAt}</span>
          </time>
        )}
      </div>
    </header>

    <div class="outline-disclosure">
      <button type="button" aria-expanded="false" aria-controls="mobile-outline">On this page</button>
      <ArticleOutline headings={headings} id="mobile-outline" />
    </div>

    <div class="article-grid">
      <ArticleOutline headings={headings} />
      <div class="prose" data-article-body>
        <Content />
        <section
          class="comments"
          aria-labelledby="comments-heading"
          data-comments
          data-configured={String(commentsConfigured)}
          data-repo={giscusRepo}
          data-repo-id={giscusRepoId}
          data-category-id={giscusCategoryId}
        >
          <h2 id="comments-heading">Discussion</h2>
          <p class="comments-fallback">
            Comments load from GitHub only when requested. The Article remains available if GitHub is blocked.
            <a href={discussionsUrl}>Open Article discussions on GitHub</a>.
          </p>
          {commentsConfigured && <button class="comments-load" type="button">Load comments</button>}
          <div class="giscus-host" aria-live="polite"></div>
        </section>
        {(newer || older) && (
          <nav class="article-sequence" aria-label="Article sequence">
            {newer && (
              <a href={newer.path} class="sequence-card newer">
                <span class="sequence-dir">← Newer</span>
                <span class="sequence-title">{newer.frontmatter.title}</span>
              </a>
            )}
            {older && (
              <a href={older.path} class="sequence-card older">
                <span class="sequence-dir">Older →</span>
                <span class="sequence-title">{older.frontmatter.title}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const body = document.querySelector<HTMLElement>('[data-article-body]');
  const outlineButton = document.querySelector<HTMLButtonElement>('.outline-disclosure > button');
  const mobileOutline = document.querySelector<HTMLElement>('#mobile-outline');
  const allOutlineLinks = [...document.querySelectorAll<HTMLAnchorElement>('.article-outline a')];
  const firstOutline = document.querySelector<HTMLElement>('.article-outline');
  const uniqueOutlineLinks = [...(firstOutline?.querySelectorAll<HTMLAnchorElement>('ol a') ?? [])];
  const headings = uniqueOutlineLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading): heading is HTMLElement => Boolean(heading));
  if (mobileOutline) mobileOutline.hidden = true;

  const closeOutline = (restoreFocus = false) => {
    if (!outlineButton || !mobileOutline) return;
    mobileOutline.hidden = true;
    outlineButton.setAttribute('aria-expanded', 'false');
    if (restoreFocus) outlineButton.focus();
  };

  outlineButton?.addEventListener('click', () => {
    if (!mobileOutline) return;
    const opening = mobileOutline.hidden;
    if (opening) document.dispatchEvent(new CustomEvent('edgseu:disclosure', { detail: 'outline' }));
    mobileOutline.hidden = !opening;
    outlineButton.setAttribute('aria-expanded', String(opening));
  });

  allOutlineLinks.forEach((link) => link.addEventListener('click', () => closeOutline()));
  document.addEventListener('edgseu:disclosure', ((event: CustomEvent<string>) => {
    if (event.detail !== 'outline') closeOutline();
  }) as EventListener);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileOutline && !mobileOutline.hidden) closeOutline(true);
  });

  const updateReadingState = () => {
    const threshold = 140;
    let activeIndex = -1;

    for (let i = 0; i < headings.length; i += 1) {
      const heading = headings[i];
      if (heading && heading.getBoundingClientRect().top <= threshold) {
        activeIndex = i;
      }
    }

    document.querySelectorAll<HTMLElement>('.article-outline').forEach((outlineNav) => {
      const links = [...outlineNav.querySelectorAll<HTMLAnchorElement>('ol a')];
      const wrap = outlineNav.querySelector<HTMLElement>('.outline-list-wrap');
      const progressBar = outlineNav.querySelector<HTMLElement>('.outline-progress-bar');

      links.forEach((link, idx) => {
        if (idx === activeIndex) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      if (progressBar && wrap && wrap.offsetHeight > 0) {
        const wrapRect = wrap.getBoundingClientRect();
        let targetHeight = 0;

        if (activeIndex >= 0 && activeIndex < links.length) {
          const activeLink = links[activeIndex];
          if (activeLink) {
            const linkRect = activeLink.getBoundingClientRect();
            const linkTopInWrap = linkRect.top - wrapRect.top;
            const startY = linkTopInWrap + linkRect.height * 0.5;

            if (activeIndex < headings.length - 1 && activeIndex + 1 < links.length) {
              const currentH = headings[activeIndex]!;
              const nextH = headings[activeIndex + 1]!;
              const nextLink = links[activeIndex + 1]!;
              const nextLinkRect = nextLink.getBoundingClientRect();
              const nextY = nextLinkRect.top - wrapRect.top + nextLinkRect.height * 0.5;

              const hCurrentTop = currentH.getBoundingClientRect().top;
              const hNextTop = nextH.getBoundingClientRect().top;
              const segmentSpan = Math.max(1, hNextTop - hCurrentTop);
              const segmentProgress = Math.max(0, Math.min(1, (threshold - hCurrentTop) / segmentSpan));

              targetHeight = startY + segmentProgress * (nextY - startY);
            } else if (body) {
              const bodyRect = body.getBoundingClientRect();
              const currentH = headings[activeIndex]!;
              const hCurrentTop = currentH.getBoundingClientRect().top;
              const remainingSpan = Math.max(1, bodyRect.bottom - threshold);
              const segmentProgress = Math.max(0, Math.min(1, (threshold - hCurrentTop) / remainingSpan));
              targetHeight = startY + segmentProgress * (wrapRect.height - startY);
            } else {
              targetHeight = startY;
            }
          }
        }

        const percentage = wrapRect.height > 0 ? Math.max(0, Math.min(100, (targetHeight / wrapRect.height) * 100)) : 0;
        progressBar.style.height = `${percentage}%`;
      }
    });
  };

  let scrollFrame = 0;
  const scheduleReadingState = () => {
    if (scrollFrame) return;
    scrollFrame = requestAnimationFrame(() => {
      scrollFrame = 0;
      updateReadingState();
    });
  };
  document.addEventListener('scroll', scheduleReadingState, { passive: true });
  scheduleReadingState();

  const copyIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="13px" height="13px" fill="currentColor" aria-hidden="true" focusable="false"><path d="M384 336l-192 0c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l140.1 0L384 95.9 384 320c0 8.8-7.2 16-16 16zM192 0C165.5 0 144 21.5 144 48l0 272c0 26.5 21.5 48 48 48l192 0c26.5 0 48-21.5 48-48l0-224c0-12.7-5.1-24.9-14.1-33.9L385.9 14.1C376.9 5.1 364.7 0 352 0L192 0zM64 128c-35.3 0-64 28.7-64 64L0 448c0 35.3 28.7 64 64 64l192 0c35.3 0 64-28.7 64-64l0-32-48 0 0 32c0 8.8-7.2 16-16 16L64 464c-8.8 0-16-7.2-16-16l0-256c0-8.8 7.2-16 16-16l32 0 0-48-32 0z"/></svg>`;
  const checkIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="13px" height="13px" fill="currentColor" aria-hidden="true" focusable="false"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/></svg>`;

  // Code blocks and tables are wrapped by rehypeArticleEnhancements at build
  // time; this script only wires behavior onto the statically rendered markup.
  document.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
    const pre = block.querySelector('pre');
    const button = block.querySelector<HTMLButtonElement>('.copy-code');
    if (!pre || !button) return;

    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.textContent ?? '');
      button.innerHTML = `${checkIconSvg} <span>Copied</span>`;
      window.setTimeout(() => {
        button.innerHTML = `${copyIconSvg} <span>Copy</span>`;
      }, 2000);
    });
  });

  const comments = document.querySelector<HTMLElement>('[data-comments]');
  const loadButton = document.querySelector<HTMLButtonElement>('.comments-load');
  let commentsLoaded = false;
  const loadComments = () => {
    if (!comments || commentsLoaded || comments.dataset.configured !== 'true') return;
    commentsLoaded = true;
    loadButton?.remove();
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.dataset.repo = comments.dataset.repo ?? '';
    script.dataset.repoId = comments.dataset.repoId ?? '';
    script.dataset.category = 'Article comments';
    script.dataset.strict = '1';
    script.dataset.reactionsEnabled = '1';
    script.dataset.emitMetadata = '0';
    script.dataset.inputPosition = 'top';
    script.dataset.theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    script.dataset.lang = 'en';
    document.querySelector('.giscus-host')?.append(script);
  };

  loadButton?.addEventListener('click', loadComments);
  if (comments && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        loadComments();
        observer.disconnect();
      }
    }, { rootMargin: '400px' });
    observer.observe(comments);
  }
  document.addEventListener('edgseu:theme', ((event: CustomEvent<string>) => {
    document.querySelector<HTMLIFrameElement>('.giscus-frame')?.contentWindow?.postMessage({
      giscus: { setConfig: { theme: event.detail === 'light' ? 'light' : 'dark' } },
    }, 'https://giscus.app');
  }) as EventListener);
</script>
