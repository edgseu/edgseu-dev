---
import type { ArticleOutlineNode } from '../lib/articles';

interface Props {
  outline?: ArticleOutlineNode[];
  headings?: ArticleOutlineNode[];
  id?: string;
}

const { headings, outline, id } = Astro.props;
const items = outline ?? headings ?? [];
---

<nav class="article-outline" id={id} aria-label="On this page">
  <h2>On this page</h2>
  <div class="outline-list-wrap">
    <div class="outline-progress-track" aria-hidden="true">
      <div class="outline-progress-bar"></div>
    </div>
    <ol>
      {items.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </div>
</nav>
