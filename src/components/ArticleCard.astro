---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import type { Article } from '../lib/articles';
interface Props {
  article: Article;
  headingLevel?: 2 | 3;
}

const { article, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { frontmatter } = article;
---

<article class={`article-card ${frontmatter.pinned ? 'is-pinned' : ''}`} data-series={frontmatter.seriesSlug}>
  {frontmatter.pinned && (
    <span class="card-pinned-pill" aria-label="Pinned article">
      <Icon name="thumbtack" size={10} /> pinned
    </span>
  )}
  <Heading><a href={article.path}>{frontmatter.title}</a></Heading>
  <p>{frontmatter.summary}</p>
  {(article.seriesPart || (frontmatter.tags && frontmatter.tags.length > 0)) && (
    <ul class="tag-list" aria-label={`${frontmatter.title} tags`}>
      {article.seriesPart && (
        <li class="tag-series" title={`Part ${article.seriesPart} of the ${frontmatter.series} series`}>
          Series Part: {article.seriesPart}
        </li>
      )}
      {frontmatter.tags?.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  <footer class="metadata">
    <span>By {profile.username}</span>
    {frontmatter.publishedAt && (
      <time datetime={frontmatter.publishedAt}>
        <Icon name="calendar" size={14} />
        <span>{frontmatter.publishedAt}</span>
      </time>
    )}
  </footer>
</article>
