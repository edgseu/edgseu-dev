---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<aside class="profile-card" aria-labelledby="profile-name">
  <div class="profile-avatar-wrap">
    <img
      class="profile-avatar"
      src={profile.avatar}
      alt={profile.name}
      width="72"
      height="72"
      decoding="async"
    />
    {profile.available && (
      <span class="status-available">
        <span class="status-ping" aria-hidden="true"></span>
        <span>Available</span>
      </span>
    )}
  </div>
  <div class="profile-identity">
    <h1 id="profile-name">{profile.name}</h1>
    <p class="role">{profile.role}</p>
  </div>
  <p class="location">
    <Icon name="location-dot" size={14} />
    <span>{profile.location}</span>
  </p>
  <ul class="focus-list" aria-label="Focus areas">
    {profile.focusAreas.map((area) => <li>{area}</li>)}
  </ul>
  <nav class="profile-links" aria-label="Profile links">
    <a href={`mailto:${profile.email}`}>
      <Icon name="envelope" size={14} />
      <span>{profile.email}</span>
    </a>
    <a href={profile.github}>
      <Icon name="github" size={14} />
      <span>GitHub</span>
      <Icon name="arrow-up-right-from-square" size={12} class="external-icon" />
    </a>
    <a href={profile.linkedin}>
      <Icon name="linkedin" size={14} />
      <span>LinkedIn</span>
      <Icon name="arrow-up-right-from-square" size={12} class="external-icon" />
    </a>
    {profile.resumeUrl && (
      <a href="/resume/">
        <Icon name="file-lines" size={14} />
        <span>Resume</span>
      </a>
    )}
  </nav>
</aside>
