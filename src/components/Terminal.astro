---
import { publishedProjects } from '../lib/projects';
import { publishedArticles } from '../lib/articles';
import { profile } from '../data/profile';
const projectCount = publishedProjects.length;
const articleCount = publishedArticles.length;
const formatSkillsGrid = (items: string[], columns = 2, gap = 4): string => {
  if (!items.length) return '';
  const maxLen = Math.max(...items.map((s) => s.length));
  const colWidth = maxLen + gap;
  const lines: string[] = [];
  for (let i = 0; i < items.length; i += columns) {
    const row = items.slice(i, i + columns);
    lines.push(row.map((item, idx) => (idx < row.length - 1 ? item.padEnd(colWidth) : item)).join(''));
  }
  return lines.join('\n');
};
const buildTime = Date.now();

const initialResponses = {
  help: 'Available commands: help, whoami, skills, contact, theme, clear',
  skills: formatSkillsGrid(profile.skills),
  contact: [
    `󰇮 Email: ${profile.email}`,
    `󰊤 GitHub: ${profile.github.replace(/^https?:\/\//, '')}`,
    `󰌻 LinkedIn: ${profile.linkedin.replace(/^https?:\/\//, '')}`,
  ].join('\n'),
  theme: '󰔎 Switched color theme.',
  clear: '',
};
---
<section class="terminal" aria-labelledby="terminal-title" data-responses={JSON.stringify(initialResponses)} data-profile={JSON.stringify(profile)} data-project-count={projectCount} data-article-count={articleCount} data-build-time={buildTime}>
  <div class="terminal-bar">
    <span class="terminal-close" aria-hidden="true">×</span>
    <h2 id="terminal-title">cloud-shell ~</h2>
  </div>
  <div class="terminal-body" id="terminal-body" tabindex="0">
    <div class="terminal-output" id="terminal-output" role="log" aria-live="polite" aria-relevant="additions">
      <p class="terminal-command-line"><span class="prompt" aria-hidden="true"><span class="prompt-user">{profile.username}</span><span class="prompt-at">@</span><span class="prompt-host">{profile.promptHost}</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span></span> <span class="cmd-valid">whoami</span></p>
      <pre class="terminal-pre"><span class="t-purple">cloud-shell</span>
<span class="t-muted">-----------</span>
<span class="t-icon t-pink"></span> <span class="t-key">user        </span> <span class="t-val">{profile.name} ({profile.username})</span>
<span class="t-icon t-cyan">󰋜</span> <span class="t-key">host        </span> <span class="t-val">{profile.host}</span>
<span class="t-icon t-purple"></span> <span class="t-key">role        </span> <span class="t-val">{profile.role}</span>
<span class="t-icon t-green"></span> <span class="t-key">loc         </span> <span class="t-val">{profile.location}</span>
<span class="t-icon t-orange">󰒍</span> <span class="t-key">skills      </span> <span class="t-val">{profile.shortSkills.join(' · ')}</span>
<span class="t-icon t-yellow">󰈙</span> <span class="t-key">projects    </span> <span class="t-val">{projectCount} featured</span>
<span class="t-icon t-cyan">󰈚</span> <span class="t-key">articles    </span> <span class="t-val">{articleCount} published</span>
<span class="t-icon t-green">󰅐</span> <span class="t-key">uptime      </span> <span class="t-val t-uptime">&lt; 1m</span></pre>
    </div>
    <form class="terminal-form" autocomplete="off">
      <label for="terminal-input"><span class="prompt" aria-hidden="true"><span class="prompt-user">{profile.username}</span><span class="prompt-at">@</span><span class="prompt-host">{profile.promptHost}</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span></span><span class="sr-only">Terminal command</span></label>
      <input id="terminal-input" name="command" inputmode="text" spellcheck="false" maxlength="32" />
    </form>
  </div>
  <div class="terminal-footer">
    <span class="terminal-hint-icon" aria-hidden="true">󰋽</span>
    <span class="terminal-hint-text">hint: type <code class="terminal-hint-code">help</code> for available commands</span>
  </div>
  <noscript><p class="terminal-noscript">Interactive commands require JavaScript. All destinations are linked below.</p></noscript>
</section>

<script>
  const terminalEl = document.querySelector<HTMLElement>('.terminal');
  const form = document.querySelector<HTMLFormElement>('.terminal-form');
  const input = document.querySelector<HTMLInputElement>('#terminal-input');
  const output = document.querySelector<HTMLElement>('#terminal-output');
  const body = document.querySelector<HTMLElement>('#terminal-body');
  const history: string[] = [];
  let historyIndex = 0;
  const commands = ['help', 'whoami', 'skills', 'contact', 'theme', 'clear'] as const;

  const projectCount = terminalEl?.dataset.projectCount ?? '0';
  const articleCount = terminalEl?.dataset.articleCount ?? '0';
  const terminalProfile = JSON.parse(terminalEl?.dataset.profile ?? 'null') as {
    name: string;
    username: string;
    role: string;
    location: string;
    promptHost: string;
    host: string;
    shortSkills: string[];
  } | null;
  const buildTime = Number(terminalEl?.dataset.buildTime ?? Date.now());

  const formatUptime = (diffMs: number): string => {
    const totalMinutes = Math.floor(Math.max(0, diffMs) / 60000);
    const days = Math.floor(totalMinutes / 1440);
    const hours = Math.floor((totalMinutes % 1440) / 60);
    const minutes = totalMinutes % 60;
    if (days > 0) return `${days}d ${hours}h ${minutes}m`;
    if (hours > 0) return `${hours}h ${minutes}m`;
    if (minutes > 0) return `${minutes}m`;
    return '< 1m';
  };

  const initialUptime = terminalEl?.querySelector('.t-uptime');
  if (initialUptime) {
    initialUptime.textContent = formatUptime(Date.now() - buildTime);
  }

  let responses: Record<string, string> = {};
  try {
    responses = JSON.parse(terminalEl?.dataset.responses ?? '{}');
  } catch {
    responses = {};
  }

  const escapeHtml = (str: string) =>
    str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const getWhoamiHtml = () => {
    if (!terminalProfile) return '';
    return `<span class="t-purple">cloud-shell</span>
<span class="t-muted">-----------</span>
<span class="t-icon t-pink"></span> <span class="t-key">user        </span> <span class="t-val">${escapeHtml(terminalProfile.name)} (${escapeHtml(terminalProfile.username)})</span>
<span class="t-icon t-cyan">󰋜</span> <span class="t-key">host        </span> <span class="t-val">${escapeHtml(terminalProfile.host)}</span>
<span class="t-icon t-purple"></span> <span class="t-key">role        </span> <span class="t-val">${escapeHtml(terminalProfile.role)}</span>
<span class="t-icon t-green"></span> <span class="t-key">loc         </span> <span class="t-val">${escapeHtml(terminalProfile.location)}</span>
<span class="t-icon t-orange">󰒍</span> <span class="t-key">skills      </span> <span class="t-val">${terminalProfile.shortSkills.map(escapeHtml).join(' · ')}</span>
<span class="t-icon t-yellow">󰈙</span> <span class="t-key">projects    </span> <span class="t-val">${projectCount} featured</span>
<span class="t-icon t-cyan">󰈚</span> <span class="t-key">articles    </span> <span class="t-val">${articleCount} published</span>
<span class="t-icon t-green">󰅐</span> <span class="t-key">uptime      </span> <span class="t-val">${formatUptime(Date.now() - buildTime)}</span>`;
  };

  const appendCommandLine = (rawCommand: string, isValid: boolean) => {
    if (!output || !terminalProfile) return;
    const line = document.createElement('p');
    line.className = 'terminal-command-line';
    line.innerHTML = `<span class="prompt" aria-hidden="true"><span class="prompt-user">${escapeHtml(terminalProfile.username)}</span><span class="prompt-at">@</span><span class="prompt-host">${escapeHtml(terminalProfile.promptHost)}</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span></span> <span class="${isValid ? 'cmd-valid' : 'cmd-invalid'}">${escapeHtml(rawCommand)}</span>`;
    output.append(line);
  };

  const appendResponse = (htmlOrText: string, isHtml = false) => {
    if (!output) return;
    if (!htmlOrText) return;
    const isMultiLine = htmlOrText.includes('\n');
    const line = document.createElement(isMultiLine ? 'pre' : 'p');
    line.className = isMultiLine ? 'terminal-pre' : 'terminal-response';
    if (isHtml) {
      line.innerHTML = htmlOrText;
    } else {
      line.textContent = htmlOrText;
    }
    output.append(line);
    while (output.childElementCount > 24) output.firstElementChild?.remove();
    if (body) body.scrollTop = body.scrollHeight;
    else output.scrollTop = output.scrollHeight;
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!input || !output) return;
    const rawCommand = input.value.trim();
    const command = rawCommand.toLowerCase();
    input.value = '';
    if (!command) return;

    const isValid = commands.includes(command as (typeof commands)[number]);
    appendCommandLine(rawCommand, isValid);

    if (!isValid) {
      appendResponse(`Unknown command: ${rawCommand}. Type help.`);
      return;
    }

    history.push(command);
    if (history.length > 20) history.shift();
    historyIndex = history.length;

    if (command === 'clear') {
      output.replaceChildren();
      return;
    }
    if (command === 'theme') {
      document.querySelector<HTMLButtonElement>('.theme-toggle')?.click();
    }
    if (command === 'whoami') {
      appendResponse(getWhoamiHtml(), true);
      return;
    }
    appendResponse(responses[command] ?? '');
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
      event.preventDefault();
      historyIndex = Math.max(0, Math.min(history.length, historyIndex + (event.key === 'ArrowUp' ? -1 : 1)));
      input.value = history[historyIndex] ?? '';
    }
    if (event.key === 'Tab' && input.value) {
      const matches = commands.filter((command) => command.startsWith(input.value.toLowerCase()));
      if (matches.length === 1) {
        event.preventDefault();
        input.value = matches[0] ?? input.value;
      }
    }
  });
</script>
