---
import Icon from './Icon.astro';
import { loadProjectCatalog } from '../lib/projects';
import { publishedArticles } from '../lib/articles';
import { profile } from '../data/profile';
import { TerminalSession, TERMINAL_COMMANDS } from '../lib/terminal';

const { publishedProjects } = await loadProjectCatalog();
const projectCount = publishedProjects.length;
const articleCount = publishedArticles.length;
const buildTime = Date.now();
const session = new TerminalSession({
  profile,
  projectCount,
  articleCount,
  buildTime,
});
const initialWhoami = session.getInitialWhoami();
---
<section
  class="terminal"
  aria-labelledby="terminal-title"
  data-profile={JSON.stringify(profile)}
  data-project-count={projectCount}
  data-article-count={articleCount}
  data-build-time={buildTime}
>
  <div class="terminal-bar">
    <h2 id="terminal-title">cloud-shell ~</h2>
    <div class="terminal-status" aria-hidden="true">
      <span class="status-ping"></span>
      <span class="status-text">online</span>
    </div>
  </div>
  <div class="terminal-body" id="terminal-body" tabindex="0">
    <div class="terminal-output" id="terminal-output" role="log" aria-live="polite" aria-relevant="additions">
      <p class="terminal-command-line"><span class="prompt" aria-hidden="true"><span class="prompt-user">{profile.username}</span><span class="prompt-at">@</span><span class="prompt-host">{profile.promptHost}</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span></span> <span class="cmd-valid">whoami</span></p>
      <pre class="terminal-pre" set:html={initialWhoami}></pre>
    </div>
    <form class="terminal-form" autocomplete="off">
      <label for="terminal-input"><span class="prompt" aria-hidden="true"><span class="prompt-user">{profile.username}</span><span class="prompt-at">@</span><span class="prompt-host">{profile.promptHost}</span><span class="prompt-colon">:</span><span class="prompt-path">~</span><span class="prompt-dollar">$</span></span><span class="sr-only">Terminal command</span></label>
      <input id="terminal-input" name="command" inputmode="text" spellcheck="false" maxlength="32" />
    </form>
  </div>
  <div class="terminal-footer">
    <Icon name="circle-info" size={13} class="terminal-hint-icon" />
    <span class="terminal-hint-text">commands:</span>
    <div class="terminal-chips">
      {TERMINAL_COMMANDS.filter((command) => command.showAsChip).map((command) => (
        <button
          type="button"
          class="terminal-chip"
          data-cmd={command.name}
          title={command.description}
        >
          {command.name}
        </button>
      ))}
    </div>
  </div>
  <noscript><p class="terminal-noscript">Interactive commands require JavaScript. All destinations are linked below.</p></noscript>
</section>

<script>
  import { TerminalSession } from '../lib/terminal';
  import type { TerminalProfile } from '../lib/terminal';

  const terminalEl = document.querySelector<HTMLElement>('.terminal');
  const form = document.querySelector<HTMLFormElement>('.terminal-form');
  const input = document.querySelector<HTMLInputElement>('#terminal-input');
  const output = document.querySelector<HTMLElement>('#terminal-output');
  const body = document.querySelector<HTMLElement>('#terminal-body');

  const projectCount = Number(terminalEl?.dataset.projectCount ?? '0');
  const articleCount = Number(terminalEl?.dataset.articleCount ?? '0');
  const terminalProfile = JSON.parse(terminalEl?.dataset.profile ?? 'null') as TerminalProfile | null;
  const buildTime = Number(terminalEl?.dataset.buildTime ?? Date.now());

  if (terminalProfile) {
    const session = new TerminalSession({
      profile: terminalProfile,
      projectCount,
      articleCount,
      buildTime,
    });

    const initialUptime = terminalEl?.querySelector('.t-uptime');
    if (initialUptime) {
      initialUptime.textContent = session.getFormattedUptime();
    }

    const appendCommandLine = (html: string) => {
      if (!output) return;
      const line = document.createElement('p');
      line.className = 'terminal-command-line';
      line.innerHTML = html;
      output.append(line);
    };

    const appendResponse = (htmlOrText: string, isHtml = false, isMultiLine = false) => {
      if (!output || !htmlOrText) return;
      const line = document.createElement(isMultiLine ? 'pre' : 'p');
      line.className = isMultiLine ? 'terminal-pre' : 'terminal-response';
      if (isHtml) line.innerHTML = htmlOrText;
      else line.textContent = htmlOrText;
      output.append(line);
      while (output.childElementCount > 24) output.firstElementChild?.remove();
      if (body) body.scrollTop = body.scrollHeight;
      else output.scrollTop = output.scrollHeight;
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input || !output) return;
      const rawCommand = input.value;
      input.value = '';
      const execution = session.submit(rawCommand);
      if (!execution) return;

      appendCommandLine(execution.commandLine.html);

      if (execution.clear) {
        output.replaceChildren();
        return;
      }
      if (execution.response) {
        if (execution.response.action === 'theme') {
          document.querySelector<HTMLButtonElement>('.theme-toggle')?.click();
        }
        appendResponse(
          execution.response.html,
          execution.response.isHtml,
          execution.response.isMultiLine,
        );
      }
    });

    input?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
        event.preventDefault();
        input.value = session.navigateHistory(event.key === 'ArrowUp' ? 'previous' : 'next');
      }
      if (event.key === 'Tab' && input.value) {
        const completion = session.complete(input.value);
        if (completion) {
          event.preventDefault();
          input.value = completion;
        }
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.terminal-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const cmd = chip.dataset.cmd;
        if (!cmd || !input || !form) return;
        input.value = cmd;
        form.dispatchEvent(new Event('submit', { cancelable: true }));
      });
    });
  }
</script>
