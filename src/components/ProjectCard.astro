---
import Icon from './Icon.astro';
import type { EnrichedProject } from '../lib/projects';

interface Props {
  project: EnrichedProject;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;

const languages = (
  project.enrichment?.languages ??
  (project.enrichment?.language ? [project.enrichment.language] : [])
).slice(0, 3);
const pushedAt = project.enrichment?.pushedAt;
---

<article class={`project-card ${project.pinned ? 'is-pinned' : ''}`}>
  {project.pinned && (
    <span class="card-pinned-pill" aria-label="Pinned project">
      <Icon name="thumbtack" size={10} /> pinned
    </span>
  )}
  <Heading>
    <a href={project.url}>
      {project.title} <Icon name="arrow-up-right-from-square" size={13} />
    </a>
  </Heading>
  <p>{project.summary}</p>
  <ul class="tag-list" aria-label={`${project.title} technologies`}>
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {(languages.length > 0 || pushedAt) && (
    <footer class="project-card-meta">
      {languages.length > 0 && (
        <span class="meta-item"><Icon name="code" size={13} /> {languages.join(', ')}</span>
      )}
      {pushedAt && (
        <span class="meta-item"><Icon name="clock" size={13} /> Updated <time datetime={pushedAt}>{pushedAt}</time></span>
      )}
    </footer>
  )}
</article>
